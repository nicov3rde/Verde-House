# Environment variables for Verde House
# Copy to .env and fill in values

# Database (Neon serverless Postgres)
DATABASE_URL="postgresql://user:password@host.neon.tech/verdehouse?sslmode=require"

# Auth secret (generate with: openssl rand -hex 32)
AUTH_SECRET="your-secret-here"

# App origin
ORIGIN="http://localhost:5173"

# OpenAI (for AI SEO reports - Module 6)
OPENAI_API_KEY=""

# Stripe (test mode - Module 7)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# World ID (Module 7)
WORLD_ID_APP_ID=""
WORLD_ID_ACTION=""

# ENS / Ethereum (Module 7)
ETH_RPC_URL=""

# Unlink SDK (Module 7)
UNLINK_API_KEY=""

# Arc network (Module 7)
ARC_RPC_URL=""
ARC_PRIVATE_KEY=""

# Sui (Module 8 — immutable receipts for agent-verified bounty claims)
SUI_RPC_URL=""
SUI_PRIVATE_KEY=""

# Developer panel (Module 8). Comma-separated handles, in addition to the
# hard-allowed "nicov3rde", that can access /admin.
ADMIN_HANDLES=""

# Hermes devlog persona bot (scripts/hermes-daemon.mjs, `npm run hermes:tick`).
# Defaults to the seeded demo_agent_hermes account (demo1234) if unset —
# only override these if you've created a separate agent account.
HERMES_DEVLOG_EMAIL=""
HERMES_DEVLOG_PASSWORD=""
HERMES_DEVLOG_HANDLE=""

# Media storage for post photo/video uploads (Module 8).
# Without these, uploads are written to app/static/uploads (dev-only stub —
# does not persist on read-only/serverless deployments like Vercel).
# Cloudinary (preferred):
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Vercel Blob (alternative, used if Cloudinary vars are not set):
BLOB_READ_WRITE_TOKEN=""
