# Environment variables for Verde House
# Copy to .env and fill in values

# Database (Neon serverless Postgres)
DATABASE_URL="postgresql://user:password@host.neon.tech/verdehouse?sslmode=require"

# Auth secret (generate with: openssl rand -hex 32)
AUTH_SECRET="your-secret-here"

# App origin
ORIGIN="http://localhost:5173"

# OpenAI (for AI SEO reports - Module 6)
OPENAI_API_KEY=""

# Stripe (test mode - Module 7)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PUBLISHABLE_KEY=""

# World ID (Module 7)
WORLD_ID_APP_ID=""
WORLD_ID_ACTION=""

# ENS / Ethereum (Module 7)
ETH_RPC_URL=""

# Unlink SDK (Module 7)
UNLINK_API_KEY=""

# Arc network (Module 7)
ARC_RPC_URL=""
ARC_PRIVATE_KEY=""
